---
interface Props {
  href: string;
  kicker: string;
  title: string;
  dek?: string;
  size?: 'large' | 'regular';
  grade?: string;
  gradeState?: 'pass' | 'watch' | 'fail';
}
const { href, kicker, title, dek, size = 'regular', grade, gradeState } = Astro.props as Props;
---
<a href={href} class:list={['ed-card', `ed-card--${size}`]}>
  <div class="ed-top">
    <span class="ed-kicker">{kicker}</span>
    {grade && <span class:list={['chip', `chip-${gradeState}`]}>Grade {grade}</span>}
  </div>
  <h3 class="ed-title">{title}</h3>
  {dek && <p class="ed-dek text-muted">{dek}</p>}
  <span class="ed-link">Read Analysis →</span>
</a>

<style>
  .ed-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 26px;
    border: 1px solid var(--rule);
    background: var(--paper);
    height: 100%;
    transition: border-color 0.15s ease;
  }
  .ed-card:hover { border-color: var(--navy); }
  .ed-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .ed-kicker {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--navy);
  }
  .ed-title { font-size: 20px; line-height: 1.25; }
  .ed-card--large .ed-title { font-size: 30px; max-width: 18ch; }
  .ed-dek { font-size: 13.5px; line-height: 1.55; }
  .ed-card--large .ed-dek { font-size: 15px; max-width: 42ch; }
  .ed-link {
    margin-top: auto;
    padding-top: 10px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: var(--navy);
  }
</style>
