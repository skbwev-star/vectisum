---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-top">
    <div class="footer-col footer-brand">
      <div class="wordmark-text">LANA</div>
      <p class="footer-motto">"I don't take sides. I take the truth."</p>
      <p class="text-muted footer-tagline">Independent cross-border property investment analyst. Stress-testing investments before capital is committed, using the Lana Method™.</p>
    </div>
    <div class="footer-col">
      <div class="footer-heading">Research</div>
      <a href="/research">Research Home</a>
      <a href="/deal-autopsies">Deal Autopsies</a>
      <a href="/investment-intelligence">Investment Intelligence</a>
      <a href="/case-studies">Case Studies</a>
      <a href="/decision-frameworks">Decision Frameworks</a>
    </div>
    <div class="footer-col">
      <div class="footer-heading">Knowledge</div>
      <a href="/knowledge">Knowledge Library</a>
      <a href="/why-investors-lose-money">Why Investors Lose Money</a>
      <a href="/methodology">Methodology</a>
      <a href="/evidence-hierarchy">Evidence Hierarchy</a>
      <a href="/sample-review">Sample Review</a>
    </div>
    <div class="footer-col">
      <div class="footer-heading">Independence</div>
      <p class="text-muted footer-note">Lana takes no commission, referral fee, or transactional interest in any property reviewed. No brokerage. No introductions. No stake in outcome.</p>
      <a href="/about" style="margin-top:6px;">About Lana</a>
      <a href="/contact">Contact</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <span class="text-muted">© {year} Lana Olenchuk. All research is analytical opinion, not financial or legal advice.</span>
    <span class="text-muted">Amsterdam</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy);
    color: rgba(255,255,255,0.72);
    padding-top: 64px;
  }
  .footer-top {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr 1.2fr;
    gap: 40px;
    padding-bottom: 48px;
    border-bottom: 1px solid rgba(255,255,255,0.15);
  }
  .footer-col { display: flex; flex-direction: column; gap: 10px; }
  .footer-col a { color: rgba(255,255,255,0.72); font-size: 13.5px; }
  .footer-col a:hover { color: #fff; }
  .wordmark-text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    color: #fff;
    letter-spacing: 0.06em;
    margin-bottom: 8px;
  }
  .footer-tagline { font-size: 13px; line-height: 1.6; max-width: 30ch; }
  .footer-motto { font-family: var(--font-display); font-weight: 700; font-size: 14px; color: var(--gold); margin-bottom: 10px; font-style: italic; }
  .footer-heading {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.45);
    margin-bottom: 4px;
  }
  .footer-note { font-size: 12px; line-height: 1.6; }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 22px var(--gutter);
  }
  .footer-bottom .text-muted { color: rgba(255,255,255,0.5); }

  @media (max-width: 800px) {
    .footer-top { grid-template-columns: 1fr 1fr; }
    .footer-bottom { flex-direction: column; gap: 6px; }
  }
</style>
