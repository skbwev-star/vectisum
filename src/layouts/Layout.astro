---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const { title, description, path, type, jsonLd } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#13294b" />
    <meta name="google-site-verification" content="omrFdgDgVZ5JUpVtGd83hECh_shSrxUHjcToWIl9CKU" />
    <meta name="msvalidate.01" content="BE0E39073FEC63321EA0E0ACA8FC5BC0" />
    <SEO title={title} description={description} path={path} type={type} jsonLd={jsonLd} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--navy);
    color: #fff;
    padding: 10px 16px;
    z-index: 100;
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .skip-link:focus {
    left: 12px;
    top: 12px;
  }
</style>
