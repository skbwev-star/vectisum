---
import Layout from '../../layouts/Layout.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import { intelligenceNotes } from '../../data/intelligence';
---
<Layout
  title="Investment Intelligence"
  description="Short-form research notes and market observations from Lana's review desk — transaction trends, data observations, and policy changes as they're seen."
  path="/investment-intelligence"
>
  <ArticleHero
    eyebrow="Investment Intelligence"
    title="Short observations from the review desk."
    dek="Not a blog. A running record of specific, dated observations drawn from reviews in progress — market direction, developer behaviour, and policy change, as it's seen, not months later."
  />

  <section class="section">
    <div class="container">
      <div class="note-list">
        {intelligenceNotes.map((n) => (
          <a href={`/investment-intelligence/${n.slug}`} class="note-row">
            <div class="note-meta">
              <span class="tag">{n.category}</span>
              <time class="text-muted">{new Date(n.published).toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
            </div>
            <h2>{n.title}</h2>
            <p class="text-muted">{n.dek}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .note-list { max-width: 780px; display: flex; flex-direction: column; }
  .note-row { display: block; padding: 28px 0; border-bottom: 1px solid var(--rule); }
  .note-row:first-child { padding-top: 0; }
  .note-meta { display: flex; align-items: center; gap: 14px; margin-bottom: 12px; }
  .note-meta time { font-family: var(--font-mono); font-size: 11.5px; }
  .note-row h2 { font-size: 20px; margin-bottom: 8px; }
  .note-row p { font-size: 14px; line-height: 1.6; }
</style>
