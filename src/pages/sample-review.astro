---
import Layout from '../layouts/Layout.astro';
import Ledger from '../components/Ledger.astro';
import DecisionDial from '../components/DecisionDial.astro';

const toc = [
  { href: '#underwriting', label: '01 · Acquisition Underwriting' },
  { href: '#scenarios', label: '02 · Scenario Analysis' },
  { href: '#comps', label: '03 · Market Comparables' },
  { href: '#memo', label: '04 · IC Memo & Verdict' },
];
---
<Layout
  title="Sample Review"
  description="A full sample independent investment review — acquisition underwriting, scenario analysis, market comparables, and an IC-ready memo with graded verdict."
  path="/sample-review"
>
  <section class="hero-simple">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Sample Review · Anonymised</span>
        <h1>A full review, section by section.</h1>
        <p class="hero-sub text-muted">
          This is a real Lana Method review structure with anonymised figures — a three-asset residential portfolio reviewed
          for a retirement-income allocation. Every number below follows the same methodology applied to every review we deliver.
        </p>
      </div>
      <div class="hero-toc">
        <div class="hero-toc-label">In this review</div>
        {toc.map((t) => <a href={t.href}>{t.label}</a>)}
      </div>
    </div>
  </section>

  <!-- 01 UNDERWRITING -->
  <section id="underwriting" class="section">
    <div class="container">
      <span class="eyebrow">01 · Acquisition Deep Underwriting</span>
      <h2 class="section-title">Dubai Hills Estate — One-Bedroom Apartment</h2>
      <p class="text-muted section-sub">645 sqft · established developer · cash purchase · long-hold strategy.</p>

      <div class="compare-row">
        <div class="compare-side">
          <div class="compare-label">Broker-quoted gross yield</div>
          <div class="compare-value">7.4%</div>
          <div class="compare-note text-muted">Annual rent ÷ ask price — excludes service charge, vacancy, management, reserve</div>
        </div>
        <div class="compare-arrow">→</div>
        <div class="compare-side compare-side--result">
          <div class="compare-label">True forensic net yield</div>
          <div class="compare-value compare-value--pass">5.6%</div>
          <div class="compare-note text-muted">After all friction costs — the decision-grade figure</div>
        </div>
      </div>

      <h3 class="table-heading">Full Income Reconciliation</h3>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Line item</th><th>Basis</th><th>Annual</th><th>Notes</th></tr>
          </thead>
          <tbody>
            <tr><td>Gross annual rent</td><td>Market mid</td><td class="num">105,000</td><td>Verified against closed-comparable rent data</td></tr>
            <tr><td>Vacancy adjustment</td><td>−2%</td><td class="num neg">−2,100</td><td>Low vacancy risk — strong tenant demand</td></tr>
            <tr><td>Management fee</td><td>−5%</td><td class="num neg">−5,250</td><td>Building-managed</td></tr>
            <tr><td>Reserve / maintenance</td><td>−2%</td><td class="num neg">−2,100</td><td>Standard reserve allocation</td></tr>
            <tr><td><strong>Net rent factor</strong></td><td><strong>0.91x</strong></td><td class="num"><strong>95,550</strong></td><td>Effective collected income</td></tr>
            <tr><td>Annual service charge</td><td>Verified index rate</td><td class="num neg">−16,177</td><td>Checked against published service-charge index</td></tr>
            <tr class="row-final"><td><strong>True net income</strong></td><td>—</td><td class="num"><strong>79,373</strong></td><td>Decision-grade figure</td></tr>
          </tbody>
        </table>
      </div>

      <Ledger cells={[
        { label: 'Ask Price', value: '1.55M' },
        { label: 'Recommended Offer', value: '1.425M', state: 'pass' },
        { label: 'True Net Yield at Offer', value: '5.57%', state: 'pass' },
        { label: 'Stressed Net Yield', value: '4.01%', state: 'watch' },
      ]} />

      <div class="verdict-strip verdict-strip--pass">
        <span class="chip chip-pass">Approved — Priority Buy</span>
        <p>Highest net yield in the shortlist. Deep tenant demand pool. Negotiate toward the recommended offer; transfer costs are sunk — a 3–4 year minimum hold is required to break even.</p>
      </div>
    </div>
  </section>

  <!-- 02 SCENARIOS -->
  <section id="scenarios" class="section section--stone">
    <div class="container">
      <span class="eyebrow">02 · Scenario Analysis</span>
      <h2 class="section-title">Base, Upside, and Downside — Applied Simultaneously</h2>
      <p class="text-muted section-sub">Three-asset portfolio · total deployment 4.705M · a combined shock scenario applied to rent, vacancy, and service charges at once.</p>

      <div class="scenario-block">
        <div class="scenario-col scenario-col--down">
          <div class="scenario-label">Downside</div>
          <div class="scenario-value">4.01%</div>
          <p class="text-muted">Rent −10%, vacancy +10pp, service charges +20% — applied together. Asset remains cash-flow positive.</p>
        </div>
        <div class="scenario-col scenario-col--base">
          <div class="scenario-label">Base</div>
          <div class="scenario-value">5.57%</div>
          <p class="text-muted">Verified net yield at the recommended offer price, before any stress applied.</p>
        </div>
        <div class="scenario-col scenario-col--up">
          <div class="scenario-label">Upside</div>
          <div class="scenario-value">6.3%</div>
          <p class="text-muted">Rent +5%, vacancy tightens by 2pp. Remains the strongest asset in the portfolio under this scenario.</p>
        </div>
      </div>

      <ul class="key-reading">
        <li>Two of three assets hold above 4.0% net yield under the combined stress scenario.</li>
        <li>The third — a lower-base-rent townhouse — compresses further under stress; flagged for conservative vacancy budgeting.</li>
        <li>All three assets remain cash-flow positive throughout the downside scenario.</li>
        <li>For non-local-currency investors, a further 2–3 point inflation adjustment applies to reach true purchasing-power return.</li>
      </ul>
    </div>
  </section>

  <!-- 03 COMPS -->
  <section id="comps" class="section">
    <div class="container">
      <span class="eyebrow">03 · Market Verification & Comparables</span>
      <h2 class="section-title">Closed Transactions, Not Listing Prices</h2>
      <p class="text-muted section-sub">Every comparable below is drawn from verified closed-transaction data — not asking prices. A Quality Score reflects data freshness, asset-class match, and location proximity.</p>

      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Building</th><th>Sqft</th><th>Closed price</th><th>Per sqft</th><th>Days on market</th><th>Quality Score</th></tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Subject comparable</strong></td>
              <td class="num">638</td>
              <td class="num">1,408,000</td>
              <td class="num">2,207</td>
              <td class="num">18</td>
              <td><span class="chip chip-pass">9 / 10</span></td>
            </tr>
            <tr>
              <td>Same community</td>
              <td class="num">487</td>
              <td class="num">1,190,000</td>
              <td class="num">2,444</td>
              <td class="num">24</td>
              <td><span class="chip chip-pass">8 / 10</span></td>
            </tr>
            <tr>
              <td>Adjacent tower</td>
              <td class="num">668</td>
              <td class="num">1,470,000</td>
              <td class="num">2,201</td>
              <td class="num">31</td>
              <td><span class="chip chip-watch">7 / 10</span></td>
            </tr>
            <tr>
              <td>Different cluster</td>
              <td class="num">612</td>
              <td class="num">1,385,000</td>
              <td class="num">2,263</td>
              <td class="num">42</td>
              <td><span class="chip chip-watch">6 / 10</span></td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="verdict-strip verdict-strip--pass">
        <p>Subject price sits within the confirmed closed-transaction corridor. The negotiated offer is defensible against real, closed data — not the top-of-range asking prices used to market comparable units.</p>
      </div>
    </div>
  </section>

  <!-- 04 IC MEMO -->
  <section id="memo" class="section section--navy memo-section">
    <div class="container memo-grid">
      <div class="memo-copy">
        <span class="eyebrow" style="color:rgba(255,255,255,0.65)">04 · IC-Ready Memorandum</span>
        <h2 class="section-title">Verdict, in Three Reasons</h2>
        <div class="memo-reasons">
          <div class="memo-reason">
            <span class="memo-reason-num">01</span>
            <p><strong>Yield is real, not brochure.</strong> Blended net yield holds after full friction-cost reconciliation and remains cash-flow positive under simultaneous stress.</p>
          </div>
          <div class="memo-reason">
            <span class="memo-reason-num">02</span>
            <p><strong>Exit liquidity confirmed.</strong> The core sub-market trades at 22–35 days on market, at 95–98% of ask — among the most liquid segments reviewed this quarter.</p>
          </div>
          <div class="memo-reason">
            <span class="memo-reason-num">03</span>
            <p><strong>Developer risk is low, but concentrated.</strong> All three assets share a single developer — a portfolio-level concentration risk to monitor, not a reason to decline.</p>
          </div>
        </div>
      </div>
      <div class="memo-dial">
        <DecisionDial grade="B+" label="Verdict Grade" />
        <a href="/contact" class="btn btn-on-navy">Commission a Review Like This</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container disclaimer-box">
      <p class="text-muted">
        Figures throughout this sample are anonymised and illustrative of the Lana Method, not a live listing. All reviews are analytical
        opinion prepared for internal investment decision-making and do not constitute regulated financial or legal advice. Independent legal
        and financial advice should be obtained before committing capital to any transaction.
      </p>
    </div>
  </section>
</Layout>

<style>
  .hero-simple { padding: 64px 0 48px; border-bottom: 1px solid var(--rule); }
  .hero-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 40px; align-items: start; }
  h1 { font-size: clamp(30px, 4.5vw, 46px); margin: 16px 0 18px; max-width: 20ch; }
  .hero-sub { font-size: 16px; max-width: 56ch; line-height: 1.6; }
  .hero-toc { border: 1px solid var(--rule); padding: 20px; display: flex; flex-direction: column; gap: 12px; }
  .hero-toc-label { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted-2); margin-bottom: 4px; }
  .hero-toc a { font-size: 13px; color: var(--navy); border-bottom: 1px solid transparent; }
  .hero-toc a:hover { border-bottom-color: var(--navy); }

  .section-title { font-size: clamp(24px, 3.2vw, 34px); margin: 14px 0 8px; max-width: 28ch; }
  .section-sub { font-size: 14.5px; max-width: 62ch; margin-bottom: 36px; }

  .compare-row { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; border: 1px solid var(--rule); margin-bottom: 40px; }
  .compare-side { padding: 22px 26px; }
  .compare-side--result { background: var(--signal-pass-bg); }
  .compare-label { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); margin-bottom: 6px; }
  .compare-value { font-family: var(--font-display); font-size: 34px; font-weight: 700; }
  .compare-value--pass { color: var(--signal-pass); }
  .compare-note { font-size: 12px; margin-top: 6px; }
  .compare-arrow { padding: 0 18px; color: var(--muted-2); font-size: 20px; }

  .table-heading { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted-2); margin-bottom: 14px; }
  .table-wrap { overflow-x: auto; margin-bottom: 32px; }
  table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
  th { text-align: left; font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted-2); border-bottom: 2px solid var(--ink); padding: 10px 12px; }
  td { padding: 11px 12px; border-bottom: 1px solid var(--rule); }
  tr.row-final td { border-bottom: 2px solid var(--ink); background: var(--stone); }
  .num { font-family: var(--font-mono); text-align: right; }
  .num.neg { color: var(--signal-fail); }

  .verdict-strip { display: flex; align-items: center; gap: 16px; padding: 18px 22px; border: 1px solid var(--rule); margin: 20px 0 8px; flex-wrap: wrap; }
  .verdict-strip--pass { background: var(--signal-pass-bg); }
  .verdict-strip p { font-size: 13.5px; line-height: 1.6; }

  .scenario-block { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--rule); border: 1px solid var(--rule); margin-bottom: 32px; }
  .scenario-col { background: var(--paper); padding: 26px 24px; }
  .scenario-label { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted-2); margin-bottom: 10px; }
  .scenario-value { font-family: var(--font-display); font-size: 32px; font-weight: 700; margin-bottom: 12px; }
  .scenario-col--down .scenario-value { color: var(--signal-fail); }
  .scenario-col--up .scenario-value { color: var(--signal-pass); }
  .scenario-col p { font-size: 12.5px; line-height: 1.5; }

  .key-reading { list-style: none; padding: 0; margin: 0; border: 1px solid var(--rule); background: var(--paper); }
  .key-reading li { padding: 13px 20px; border-bottom: 1px solid var(--rule); font-size: 13.5px; line-height: 1.6; position: relative; padding-left: 34px; }
  .key-reading li:last-child { border-bottom: none; }
  .key-reading li::before { content: '—'; position: absolute; left: 14px; color: var(--navy); }

  .memo-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 48px; align-items: start; }
  .memo-section .section-title { color: #fff; }
  .memo-reasons { display: flex; flex-direction: column; gap: 20px; margin-top: 24px; }
  .memo-reason { display: flex; gap: 16px; }
  .memo-reason-num { font-family: var(--font-display); font-weight: 800; font-size: 22px; color: rgba(255,255,255,0.4); }
  .memo-reason p { font-size: 14.5px; line-height: 1.6; color: rgba(255,255,255,0.85); }
  .memo-dial { display: flex; flex-direction: column; align-items: center; gap: 20px; border: 1px solid rgba(255,255,255,0.2); padding: 32px 20px; }

  .disclaimer-box { padding: 20px 24px; background: var(--stone); border: 1px solid var(--rule); }
  .disclaimer-box p { font-size: 12px; line-height: 1.6; }

  @media (max-width: 900px) {
    .hero-grid, .memo-grid, .compare-row, .scenario-block { grid-template-columns: 1fr; }
    .compare-arrow { transform: rotate(90deg); padding: 8px 0; }
  }
</style>
