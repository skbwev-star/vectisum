---
import Layout from '../../layouts/Layout.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import KnowledgeCard from '../../components/KnowledgeCard.astro';
import { knowledgeCategories } from '../../data/knowledge';
---
<Layout
  title="Knowledge"
  description="An institutional knowledge library on cross-border property investment: fundamentals, markets, valuation, risk, and structuring — written as research, not marketing."
  path="/knowledge"
>
  <ArticleHero
    eyebrow="Knowledge Library"
    title="A working reference for cross-border property investment."
    dek="Written as institutional research, not SEO content. Each category is a standing reference this library adds to over time — not a one-time explainer."
  />

  <section class="section">
    <div class="container">
      <div class="k-grid">
        {knowledgeCategories.map((k, i) => (
          <KnowledgeCard href={`/knowledge/${k.slug}`} title={k.title} dek={k.dek} num={String(i + 1).padStart(2, '0')} />
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .k-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  @media (max-width: 980px) { .k-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .k-grid { grid-template-columns: 1fr; } }
</style>
