---
import Layout from '../layouts/Layout.astro';
import ArticleHero from '../components/ArticleHero.astro';

const levels = [
  {
    n: '1',
    name: 'Government Registry',
    desc: 'Closed transaction registries, land registries, and official title records. The highest-weight evidence available — a recorded fact, not a claim.',
    examples: 'DLD, RERA, HM Land Registry, and equivalent public-registry infrastructure across the jurisdictions this desk covers.',
    weight: 100,
  },
  {
    n: '2',
    name: 'Independent Valuation & Index Data',
    desc: 'Official service-charge indices, government fee schedules, and independent valuation infrastructure not controlled by a transaction party.',
    examples: 'Published service-charge indices, government transfer-fee schedules, RICS-aligned valuation data where available.',
    weight: 78,
  },
  {
    n: '3',
    name: 'Rental & Market Evidence',
    desc: 'Aggregated market indices and independent third-party data providers — reliable directionally, verified against registry data wherever a discrepancy appears.',
    examples: 'Independent market-index providers, aggregated rental data platforms, third-party comparable databases.',
    weight: 55,
  },
  {
    n: '4',
    name: 'Developer & Vendor Claims',
    desc: 'Statements from the party with a direct financial interest in the transaction closing. Logged and checked, never assumed.',
    examples: 'Developer-quoted service charges, absorption rates, projected yields, and completion timelines.',
    weight: 30,
  },
  {
    n: '5',
    name: 'Marketing Material',
    desc: 'Sales brochures, listing copy, and broker-supplied comparables. The lowest-weight tier — treated as a claim to verify, not a fact to report.',
    examples: 'Brochure yield figures, listing photography captions, broker WhatsApp comparables.',
    weight: 12,
  },
];
---
<Layout
  title="Evidence Hierarchy"
  description="How Lana ranks the sources behind every claim in an independent investment review, from government registry data to marketing material."
  path="/evidence-hierarchy"
>
  <ArticleHero
    eyebrow="Evidence Hierarchy"
    title="Not every source deserves the same weight."
    dek="Every claim in a review is checked against a source, and every source is ranked. This is the ranking — and why it holds."
  />

  <section class="section">
    <div class="container">
      <div class="pyramid">
        {levels.map((l) => (
          <div class="tier" style={`--w: ${l.weight}%`}>
            <div class="tier-bar">
              <span class="tier-n">Level {l.n}</span>
              <span class="tier-name">{l.name}</span>
            </div>
            <p class="tier-desc text-muted">{l.desc}</p>
            <p class="tier-examples text-muted"><strong>Typical sources:</strong> {l.examples}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--navy">
    <div class="container principle-row">
      <div class="principle">
        <span class="eyebrow" style="color:rgba(255,255,255,0.65)">Principle 01</span>
        <h3>A claim without a Level 1–3 source is marked Unverifiable.</h3>
        <p style="color:rgba(255,255,255,0.72)">It is excluded from the financial model rather than assumed true on the strength of the seller's word.</p>
      </div>
      <div class="principle">
        <span class="eyebrow" style="color:rgba(255,255,255,0.65)">Principle 02</span>
        <h3>Level 4 and 5 sources are logged, not discarded.</h3>
        <p style="color:rgba(255,255,255,0.72)">The Evidence Matrix records what the seller claimed, and states plainly whether it held up — the record matters even when the claim did not.</p>
      </div>
      <div class="principle">
        <span class="eyebrow" style="color:rgba(255,255,255,0.65)">Principle 03</span>
        <h3>Where no Level 1 or 2 source exists in a jurisdiction, the review says so.</h3>
        <p style="color:rgba(255,255,255,0.72)">Data availability varies by market. A gap in registry infrastructure is disclosed explicitly, not silently filled with a lower-tier source presented as equivalent.</p>
      </div>
    </div>
  </section>

  <section class="section cta-section">
    <div class="container cta-inner">
      <div>
        <h2>See the hierarchy applied to a real review.</h2>
        <p class="text-muted">Read the sample review to see the Evidence Matrix in practice.</p>
      </div>
      <a href="/sample-review" class="btn btn-primary">See the Sample Review</a>
    </div>
  </section>
</Layout>

<style>
  .pyramid { display: flex; flex-direction: column; gap: 22px; max-width: 780px; }
  .tier-bar { display: flex; align-items: center; gap: 14px; margin-bottom: 10px; }
  .tier { position: relative; padding-left: 0; }
  .tier::before {
    content: '';
    display: block;
    height: 8px;
    width: var(--w);
    background: var(--navy);
    margin-bottom: 14px;
  }
  .tier-n { font-family: var(--font-mono); font-size: 11px; color: var(--muted-2); }
  .tier-name { font-family: var(--font-display); font-weight: 700; font-size: 19px; }
  .tier-desc { font-size: 14px; line-height: 1.6; margin-bottom: 8px; }
  .tier-examples { font-size: 12.5px; line-height: 1.5; }

  .principle-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
  .principle h3 { color: #fff; font-size: 17px; margin: 14px 0 10px; line-height: 1.35; }
  .principle p { font-size: 13.5px; line-height: 1.6; }

  .cta-inner { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
  .cta-inner h2 { font-size: 26px; margin-bottom: 8px; }

  @media (max-width: 800px) {
    .principle-row { grid-template-columns: 1fr; }
  }
</style>
