---
import Layout from '../../layouts/Layout.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import { frameworks } from '../../data/frameworks';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'The Lana Method',
  itemListElement: frameworks.map((f, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: f.name,
    url: `https://www.lana-olenchuk.com/methodology/${f.slug}`,
  })),
};
---
<Layout
  title="Methodology"
  description="The Lana Method: the real six-layer forensic risk audit — market screen, true net yield model, comparable analysis, stress test, risk register, and acquisition sequence."
  path="/methodology"
  jsonLd={jsonLd}
>
  <ArticleHero
    eyebrow="Methodology"
    title="The Lana Method. Six layers. One acquisition sequence."
    dek="Verify. Stress-test. Replace. This is the same sequence run on every engagement, regardless of asset class or jurisdiction — a disclosed formula and a named risk, not a black-box score."
  />

  <section class="section tagline-section">
    <div class="container">
      <div class="tagline-box">
        <div class="line-1">I don't take sides.</div>
        <div class="line-2">I take the truth.</div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="steps">
        {frameworks.map((f) => (
          <a href={`/methodology/${f.slug}`} class="step-row">
            <div class="step-index">{f.index}</div>
            <div class="step-body">
              <h2>{f.name}</h2>
              <p class="step-lede">{f.oneLiner}</p>
              <p class="step-detail text-muted">{f.purpose}</p>
              <span class="step-link">Read the stage →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--stone">
    <div class="container evidence-teaser">
      <div>
        <span class="eyebrow">Evidence Hierarchy</span>
        <h2>Not all sources carry the same weight.</h2>
        <p class="text-muted">A closed transaction outweighs a listing. See how every claim in a review is ranked and checked.</p>
      </div>
      <a href="/evidence-hierarchy" class="btn btn-secondary">View the Evidence Hierarchy</a>
    </div>
  </section>

  <section class="section cta-section">
    <div class="container cta-inner">
      <div>
        <h2>See the Method applied to a real deal.</h2>
        <p class="text-muted">Read a full sample review, section by section.</p>
      </div>
      <a href="/sample-review" class="btn btn-primary">See the Sample Review</a>
    </div>
  </section>
</Layout>

<style>
  .steps { display: flex; flex-direction: column; }
  .step-row { display: grid; grid-template-columns: 90px 1fr; gap: 24px; padding: 34px 0; border-bottom: 1px solid var(--rule); }
  .step-row:first-child { padding-top: 0; }
  .step-index { font-family: var(--font-mono); font-size: 13px; color: var(--muted-2); padding-top: 4px; }
  .step-body h2 { font-size: 22px; margin-bottom: 6px; }
  .step-lede { font-family: var(--font-mono); font-size: 12.5px; color: var(--navy); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 10px; }
  .step-detail { font-size: 14.5px; line-height: 1.65; max-width: 68ch; margin-bottom: 12px; }
  .step-link { font-family: var(--font-mono); font-size: 11.5px; color: var(--navy); }

  .evidence-teaser { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
  .evidence-teaser h2 { font-size: 26px; margin: 12px 0 8px; }
  .evidence-teaser p { max-width: 46ch; }

  .cta-inner { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
  .cta-inner h2 { font-size: 26px; margin-bottom: 8px; }

  .tagline-section { padding: 32px 0 0; border-top: none; }
</style>
