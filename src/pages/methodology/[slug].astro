---
import Layout from '../../layouts/Layout.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import { frameworks, getFramework } from '../../data/frameworks';

export function getStaticPaths() {
  return frameworks.map((f) => ({ params: { slug: f.slug }, props: { framework: f } }));
}
const { framework } = Astro.props;
const idx = frameworks.findIndex((f) => f.slug === framework.slug);
const prev = frameworks[idx - 1];
const next = frameworks[idx + 1];
---
<Layout
  title={framework.name.replace('™', '')}
  description={framework.purpose}
  path={`/methodology/${framework.slug}`}
>
  <ArticleHero
    eyebrow={`The Lana Method · Stage ${framework.index} of ${String(frameworks.length).padStart(2, '0')}`}
    title={framework.name}
    dek={framework.oneLiner}
    backHref="/methodology"
    backLabel="All Stages"
  />

  <section class="section">
    <div class="container narrow">
      <h2 class="h">Purpose</h2>
      <p class="text-muted body-p">{framework.purpose}</p>

      <div class="io-grid">
        <div class="io-col">
          <h3 class="io-heading">Inputs</h3>
          <ul class="io-list">
            {framework.inputs.map((i) => <li>{i}</li>)}
          </ul>
        </div>
        <div class="io-col">
          <h3 class="io-heading">Outputs</h3>
          <ul class="io-list">
            {framework.outputs.map((o) => <li>{o}</li>)}
          </ul>
        </div>
      </div>

      <h2 class="h">Decision Use</h2>
      <p class="text-muted body-p">{framework.decisionUse}</p>

      <div class="example-box">
        <div class="example-label">Illustrative Example</div>
        <p>{framework.example}</p>
      </div>
    </div>
  </section>

  <section class="section section--stone">
    <div class="container pager">
      {prev ? <a href={`/methodology/${prev.slug}`} class="pager-link">← {prev.name}</a> : <span />}
      {next ? <a href={`/methodology/${next.slug}`} class="pager-link pager-link--next">{next.name} →</a> : <span />}
    </div>
  </section>
</Layout>

<style>
  .narrow { max-width: 700px; }
  .h { font-size: 22px; margin: 40px 0 14px; }
  .h:first-child { margin-top: 0; }
  .body-p { font-size: 15.5px; line-height: 1.75; }
  .io-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin: 32px 0; border: 1px solid var(--rule); }
  .io-col { padding: 22px 24px; }
  .io-col:first-child { border-right: 1px solid var(--rule); }
  .io-heading { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted-2); margin-bottom: 14px; }
  .io-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .io-list li { font-size: 13.5px; line-height: 1.5; padding-left: 16px; position: relative; }
  .io-list li::before { content: '—'; position: absolute; left: 0; color: var(--navy); }
  .example-box { background: var(--stone); border-left: 3px solid var(--gold, var(--navy)); padding: 20px 24px; margin-top: 10px; }
  .example-label { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted-2); margin-bottom: 10px; }
  .example-box p { font-size: 14.5px; line-height: 1.65; }

  .pager { display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
  .pager-link { font-family: var(--font-mono); font-size: 13px; color: var(--navy); }
  .pager-link--next { margin-left: auto; text-align: right; }

  @media (max-width: 700px) {
    .io-grid { grid-template-columns: 1fr; }
    .io-col:first-child { border-right: none; border-bottom: 1px solid var(--rule); }
  }
</style>
